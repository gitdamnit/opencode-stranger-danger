{
  "name": "@gitdamnit/stranger-danger",
  "version": "0.2.0",
  "description": "Secret and PII redaction guard for AI coding agents — scans files, context windows, and outputs before secrets reach LLMs",
  "license": "MIT",
  "type": "module",
  "main": "dist/plugin/index.js",
  "exports": {
    ".": "./dist/plugin/index.js",
    "./engine": "./dist/engine/scanner.js"
  },
  "bin": {
    "sd": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "rules/gitleaks-rules.toml",
    ".strangerdanger-allowlist.toml",
    "strangerdanger.jpeg",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "build:rules": "tsx scripts/compile-rules.ts",
    "prebuild": "npm run build:rules",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts tests/*/*.test.ts",
    "test:unit": "tsx --test tests/engine/*.test.ts tests/cli/*.test.ts tests/plugin/*.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:security": "tsx --test tests/hardening.test.ts tests/pentest.test.ts",
    "pretest": "npm run build:rules",
    "verify:package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.29",
    "@types/node": "^22.19.19",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
